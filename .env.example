# Local Matrix Stack - Environment Configuration
# Copy this file to .env and fill in your values

# Domain & Server Configuration
## Your Matrix server domain (e.g., matrix.example.com)
MATRIX_SERVER_NAME=matrix.example.com

## LiveKit domain (e.g., livekit.example.com)
LIVEKIT_DOMAIN=livekit.example.com

## LiveKit websocket domain
LIVEKIT_URL=WSS://livekit.example.com

## Reverse proxy internal IP (for LiveKit to reach reverse proxy)
REVERSE_PROXY_IP=192.168.1.100

# Secrets 
## Generate secrets with:
##   openssl rand -base64 32

# PostgreSQL password
POSTGRES_PASSWORD=

# LiveKit API secret
LIVEKIT_SECRET=
